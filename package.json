{
  "name": "kbp-app",
  "version": "0.3.22",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "dev:server": "cd server && set DJANGO_DEBUG=1&& python manage.py runserver 0.0.0.0:8000",
    "docker:up": "docker compose --profile tunnel up -d --build",
    "docker:up:fast": "docker compose --profile tunnel up -d",
    "docker:rebuild": "docker compose build --no-cache",
    "docker:down": "docker compose down",
    "setup:hosts": "powershell -ExecutionPolicy Bypass -File scripts/setup-hosts.ps1",
    "build": "next build",
    "build:mobile": "node build-mobile.js",
    "build:android": "node build-mobile.js",
    "bump:version": "node scripts/bump-version.js",
    "build:android:capacitor": "node build-mobile.js",
    "build:android:native": "node scripts/build-native-android.js assembleDebug",
    "build:android:native:release": "node scripts/build-native-android.js assembleRelease",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:run": "npm run build:android:native && npm run android:install",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "desktop": "node scripts/run-desktop.js",
    "build:desktop": "node build-desktop.js",
    "pack:desktop": "node scripts/pack-desktop-releases.js",
    "desktop:start": "npm start --prefix desktop",
    "cap:sync": "npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.3.1",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capgo/capacitor-social-login": "^8.3.39",
    "@vercel/analytics": "^2.0.1",
    "jsqr": "^1.4.0",
    "next": "16.0.8",
    "qr-code-styling": "^1.9.2",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-qr-code": "^2.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.11.15",
    "eslint": "^9",
    "eslint-config-next": "16.0.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
