<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Legacy native UI styles (not used by Capacitor WebView, kept for compile parity). -->

    <style name="BottomNavTheme" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@drawable/bg_bottom_nav</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="SettingsPageTitle">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsSectionHeader">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/textMuted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="SettingsRowTitle">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingsRowSubtitle">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SettingsThemeLabel">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="SettingsSwitch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb_tint</item>
        <item name="trackTint">@color/switch_track_tint</item>
    </style>

    <style name="SettingsChipButton">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/bg_settings_chip</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="SettingsClearButton">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/settings_clear_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">@drawable/bg_settings_clear_button</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">12dp</item>
    </style>

    <style name="SettingsSegmentItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/segment_text_color</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:background">@drawable/bg_segment_item</item>
    </style>

    <style name="ProfilePageTitle">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ProfileSubtitle">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ProfileSectionTitle">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ProfileFieldLabel">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="AuthEditText">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorHint">@color/textMuted</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="ProfileEditText">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorHint">@color/textMuted</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ProfileLink">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ProfileInlineAction">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/bg_inline_action_bottom</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">12dp</item>
    </style>

    <style name="MiniKbpButton" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/button_primary_tint</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:paddingVertical">12dp</item>
    </style>

    <style name="MiniKbpButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:paddingVertical">12dp</item>
    </style>

</resources>
