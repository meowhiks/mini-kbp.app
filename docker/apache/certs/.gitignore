# Local TLS for Apache :443 (generated by scripts/gen-local-certs.sh).
# Public HTTPS for *.mini-kbp.site is terminated at Cloudflare Tunnel; origin stays HTTP :80.

Keys and private material — do not commit:
*.key
ca.srl
*.csr

# Generated certs (regenerate with scripts/gen-local-certs.sh)
ca.crt
mini-kbp.site.crt
mini-kbp.site.fullchain.crt

# Keep openssl-san.cnf tracked
!openssl-san.cnf
