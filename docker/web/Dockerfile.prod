# Production web: Next.js build в образе, старт без dev-сервера
FROM node:20-alpine

WORKDIR /app

ARG NEXT_PUBLIC_MINIKBP_SERVER_URL=https://lk.mini-kbp.site
ARG NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
ARG NEXT_PUBLIC_TELEGRAM_BOT_CLIENT_ID=
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ARG APP_PUBLIC_URL=https://lk.mini-kbp.site

ENV NEXT_PUBLIC_MINIKBP_SERVER_URL=$NEXT_PUBLIC_MINIKBP_SERVER_URL
ENV NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=$NEXT_PUBLIC_TELEGRAM_BOT_USERNAME
ENV NEXT_PUBLIC_TELEGRAM_BOT_CLIENT_ID=$NEXT_PUBLIC_TELEGRAM_BOT_CLIENT_ID
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID
ENV APP_PUBLIC_URL=$APP_PUBLIC_URL
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

COPY package.json package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm npm ci

COPY . .
ENV NODE_ENV=production
RUN npm run build

EXPOSE 3000
CMD ["npm", "run", "start", "--", "-H", "0.0.0.0", "-p", "3000"]
