# Скопируйте в .env и отредактируйте.
# cp env.example .env   (Linux/macOS)
# copy env.example .env (Windows)

# Публичный URL (для Cloudflare Tunnel — https)
APP_PUBLIC_URL=https://lk.mini-kbp.site
NEXT_PUBLIC_MINIKBP_SERVER_URL=https://lk.mini-kbp.site
APP_DEPLOY_HOST=lk.mini-kbp.site

# Django: доп. хосты и CORS (через запятую, если нужно)
# Capacitor APK (https://localhost) уже в settings.py; сюда — только доп. origin'ы
# DJANGO_ALLOWED_HOSTS=
# DJANGO_CORS_ORIGINS=https://lk.mini-kbp.site,https://panel.mini-kbp.site,https://mini-kbp.site

# Telegram Login Widget (BotFather → /setdomain → lk.mini-kbp.site)
# Виджет не работает на localhost:3000 и IP — только на домене из /setdomain.
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=mini_kbp_bot
NEXT_PUBLIC_TELEGRAM_BOT_CLIENT_ID=8343745062
# Webhook: curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://lk.mini-kbp.site/api/telegram/webhook/"
# TELEGRAM_WEBHOOK_SECRET=
# Client Secret из BotFather → Bot Settings → Web Login (для мобильного OIDC redirect)
TELEGRAM_OIDC_CLIENT_SECRET=
# APP_AUTH_ALLOW_DEV_TELEGRAM=1

# Google Identity Services (OAuth 2.0 Client ID → Web application)
# Authorized JavaScript origins: https://lk.mini-kbp.site (и localhost:3000 для dev)
GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Email: Resend (предпочтительно). Пока домен не верифицирован — from = onboarding@resend.dev
APP_EMAIL_ENABLED=1
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=MiniKBP <onboarding@resend.dev>
# После верификации mini-kbp.site в Resend:
# DEFAULT_FROM_EMAIL=МиниКБиП <noreply@mini-kbp.site>

# Запасной путь — Postfix/SMTP (если RESEND_API_KEY пустой)
EMAIL_HOST=postfix
EMAIL_PORT=25
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
POSTFIX_HOSTNAME=mail.mini-kbp.site
# POSTFIX_ALLOWED_SENDER_DOMAINS=mini-kbp.site,lk.mini-kbp.site
# Relay для доставки в интернет (порт 25 с Docker/Windows обычно заблокирован):
# EMAIL_RELAYHOST=[smtp.yandex.ru]:587
# EMAIL_RELAYHOST_USER=noreply@mini-kbp.site
# EMAIL_RELAYHOST_PASSWORD=
#
# Или SMTP напрямую из Django (без postfix):
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=noreply@mini-kbp.site
# EMAIL_HOST_PASSWORD=

# OCR замен расписания (OpenAI-compatible vision)
# REPLACEMENT_VISION_API_KEY=
# REPLACEMENT_VISION_API_URL=https://api.openai.com/v1
# REPLACEMENT_VISION_MODEL=gpt-4o-mini

# --- Cloudflare Tunnel (выберите один способ) ---

# Способ A (проще): токен из Zero Trust → Networks → Tunnels → Configure
CLOUDFLARE_TUNNEL_TOKEN=

# Способ B: UUID туннеля + config.yml + credentials.json в docker/cloudflare/
# CLOUDFLARE_TUNNEL_ID=
